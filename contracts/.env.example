# Documentation only. Hardhat deliberately does not auto-load this file.
# Never paste a key into a local .env, issue, PR, chat, or committed file. The
# clean deployment runner injects its single-use key only after no-key preview.
LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/http
